# The docs site is VitePress under docs-site/, and it carries its own
# .gitignore for .vitepress/dist, .vitepress/cache and the generated
# reference/ layer. There is no mkdocs in this repo and no docs/_site.

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# `lib/` matches Python build artifacts; the negation below restores
# the frontend's `src/lib/` source folder which would otherwise be
# silently ignored (and missed by `git add` — exactly the trap that
# produced the round-1 "112 typescript-eslint errors in CI for
# unresolvable @/lib/types imports" failure).
lib/
!frontend/src/lib/
!frontend/src/lib/**
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv
.venv/
venv/
env/
ENV/

# Pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# mypy / ruff / type-checkers
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyright/
.pyre/

# --- Node / Frontend ---
node_modules
.npm/
.yarn/
yarn-error.log
package-lock.json.bak
dist/
.vite/
.parcel-cache/

# Build output
build/
out/
.next/
.nuxt/
.svelte-kit/
.tsbuildinfo
*.tsbuildinfo

# --- Rust / Tauri desktop shell ---
desktop/target/
# Tauri regenerates gen/schemas/ from capabilities/ on every build.
desktop/gen/schemas/
# The frozen binaries `make desktop` stages for `externalBin` (and the
# placeholders `make desktop-test` stands in for them). Build artefacts —
# never committed. The .gitkeep holds the directory shape for a fresh clone.
desktop/binaries/*
!desktop/binaries/.gitkeep

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# --- Linux ---
*~
.directory
.Trash-*

# --- Windows ---
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- IDE / Editors ---
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.shared
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Local data / runtime ---
*.db
*.db-journal
*.db-wal
*.db-shm
data/
.coffer/
local/

# --- Secrets / env ---
.env
.env.*
!.env.example
.envrc
secrets/
*.pem
*.key
!*.pub.key

# --- SBOM / build artifacts ---
sbom/
*.sbom.json
*.cdx.json

# --- Coverage / reports ---
coverage/
.nyc_output/
playwright-report/
test-results/

# --- Q01 perf gate generated artifacts ---
# Per-run NDJSON / JSON results are gitignored; the .gitkeep keeps the
# directory shape so the runner can write into it on a fresh clone.
backend/tests/perf/results/*
!backend/tests/perf/results/.gitkeep

# --- Misc ---
.cache/
tmp/
temp/

# --- Per-developer Claude Code state (local-only; not shared across clones) ---
# settings.local.json is where the CLI writes one machine's permission grants.
# A user's global ignore may already cover it, but a global ignore is not the
# repo's contract: without this line, the first contributor whose global ignore
# differs commits their own allowlist.
.claude/settings.local.json

# --- /next-task autonomous loop (local-only; not shared across clones) ---
.claude/commands/*
# OpenSpec's /opsx commands are generated by `openspec init --tools claude` and
# shared by every clone, so they are tracked.
!.claude/commands/opsx/
.claude/loop-state.json
.claude/loop-history.md
.claude/scheduled_tasks.lock
.claude/worktrees/

# stray worktree dir created by tooling typo (.claire, not .claude)
.claire/

# Superpowers / AI planning artifacts — never committed to the repo
docs/superpowers/
.superpowers/

# Local-only intermediate reports (full-codebase reviews, audits) — keep out of the repo
/FULL-REVIEW-*.md

# PyInstaller build artefacts + the binaries `make bundle-binaries` stages
build/
dist/
*.spec.lock

# Opt-in eval-capture sink (ADR eval-capture-and-regression-gate) — a local dev artefact, never committed.
*eval-capture*.jsonl
evals/captured/

# verify-before-commit freshness stamp (scripts/verify_stamp.py) — local only.
.coffer-verify.stamp
